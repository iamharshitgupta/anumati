rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Browser realtime reads are owner-only, including staff. Cross-account
    // staff reads go through the API's revoked-session checks, not cached claims.
    // Server SDK writes bypass these rules; browser writes stay denied.
    function signedIn() { return request.auth != null; }
    function owns(doc) {
      return signedIn() && request.auth.uid == doc.data.get('user_id', '');
    }
    match /mandates/{id} { allow read: if owns(resource); allow write: if false; }
    match /receipts/{id} { allow read: if owns(resource); allow write: if false; }
    match /stepups/{id}  { allow read: if owns(resource); allow write: if false; }
    match /disputes/{id} { allow read: if owns(resource); allow write: if false; }
    match /decisions/{id} {
      allow read: if signedIn() && request.auth.uid == resource.data.request.user_id;
      allow write: if false;
    }
    match /{other=**} { allow read, write: if false; }
  }
}
